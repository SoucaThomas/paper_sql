{
  "name": "paper_sql",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:shell": "docker exec -it paper_sql_db /opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\"",
    "dev": "bun --watch server/index.ts",
    "dev:web": "bun --cwd web run dev",
    "build": "bun --cwd web run build",
    "format": "oxfmt && bun run format:sql",
    "format:sql": "for f in db/*.sql; do [ -e \"$f\" ] && sql-formatter -c .sql-formatter.json --fix \"$f\"; done; true",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "mssql": "^12.8.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "bun-types": "^1.4.5",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "sql-formatter": "^15.10.0"
  }
}
